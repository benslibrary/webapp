# NextAuth — required in production. Generate with: openssl rand -base64 32
AUTH_SECRET=

# Naver OAuth — register an app at https://developers.naver.com/apps/
# Set callback URL to https://<your-domain>/api/auth/callback/naver
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Postgres (Neon via Vercel integration in prod)
POSTGRES_URL=
