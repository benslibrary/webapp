    "geist": "^1.3.1",
    "lucide-react": "^0.446.0",
    "next": "16.0.10",
    "next-auth": "5.0.0-beta.25",
    "postgres": "^3.4.4",
    "react": "19.0.1",
    "react-dom": "19.0.1",
    "server-only": "^0.0.1",
